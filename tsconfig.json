{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ESNext", "DOM"],
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun", "svelte"],
		"verbatimModuleSyntax": true
	},
	// The example app checks itself. The root covers the repo scripts, the spec, and the web package. TypeScript's wildcards skip dot folders, so those are listed by name.
	"include": ["packages", "spec", "scripts", ".github/scripts"],
	// Fixtures that are compiled inside their own install, against React's and Next's types.
	"exclude": ["packages/web/e2e/consumer-react", "packages/web/e2e/consumer-next"]
}
