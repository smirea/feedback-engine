# env-manager: feedback-engine
# env-manager local:true
# env-manager generate: env.ts

UI_URL=http://feedback-engine.localhost # {url}
UI_PORT=6180 # {int}

# Where the example's dev server forwards ProcrastiMate posts, and the token it adds. Without a token the Share menu has no ProcrastiMate entry.
PROCRASTIMATE_URL=https://procrastimate.stf.lol # {url}
PROCRASTIMATE_TOKEN= # {optional string}

# Where the examples post feedback as a webhook, and the key they send with it. Without a URL the Share menu has no GitHub Issue entry. docs/webhooks.md has a server to point it at.
FEEDBACK_WEBHOOK_URL= # {optional url}
FEEDBACK_WEBHOOK_KEY= # {optional string}
