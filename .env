# env-manager: feedback-engine
# env-manager local:true
# env-manager generate: examples/todo-svelte/env.ts

UI_URL=http://feedback-engine.localhost # {url}
UI_PORT=6180 # {int}

# Where the example's dev server forwards ProcrastiMate posts, and the token it adds. Without a token the post says so.
PROCRASTIMATE_URL=https://procrastimate.stf.lol # {url}
PROCRASTIMATE_TOKEN= # {optional string}
