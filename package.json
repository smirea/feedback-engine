{
	"name": "@smirea/feedback-engine",
	"version": "0.1.0",
	"description": "In-app feedback for iOS, Svelte, and React: point at a component, write what should change, and export its name, file:line, and data for an agent.",
	"keywords": [
		"accessibility",
		"agents",
		"annotation",
		"feedback",
		"react",
		"screenshot",
		"svelte",
		"swiftui",
		"vite"
	],
	"repository": "github:smirea/feedback-engine",
	"workspaces": [
		"examples/*"
	],
	"files": [
		"packages/web/src",
		"Package.swift",
		"packages/ios/Sources"
	],
	"type": "module",
	"exports": {
		"./react": {
			"types": "./packages/web/src/react/public.d.ts",
			"default": "./packages/web/src/react/index.ts"
		},
		"./svelte": {
			"svelte": "./packages/web/src/svelte/index.ts",
			"default": "./packages/web/src/svelte/index.ts"
		},
		"./vite": {
			"types": "./packages/web/src/vite/index.d.ts",
			"default": "./packages/web/src/vite/index.js"
		},
		"./core": "./packages/web/src/core/index.ts"
	},
	"scripts": {
		"build": "bun --filter 'todo-*' build",
		"dev": "bun --filter todo-svelte dev --host 127.0.0.1",
		"dev:react": "bun --filter todo-react dev --host 127.0.0.1",
		"env:generate": "env-manager gen --local",
		"hooks": "lefthook install",
		"lint": "oxlint --fix && oxfmt --write .",
		"lint:ci": "oxlint && oxfmt --check .",
		"preview": "bun --filter todo-svelte preview --host 127.0.0.1",
		"preview:react": "bun --filter todo-react preview --host 127.0.0.1",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "bun --filter 'todo-*' check && svelte-check-native --tsconfig ./packages/web/tsconfig.json && bun check",
		"test:web": "bun test --timeout 120000 ./packages/web/e2e/feedback.e2e.ts ./packages/web/e2e/consumer.e2e.ts",
		"worktree:setup": "bun run hooks"
	},
	"dependencies": {
		"dom-accessibility-api": "^0.7.1",
		"modern-screenshot": "^4.7.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/pngjs": "^6.0.5",
		"env-manager": "github:smirea/env-manager#1b0393e4423946c0be7c6156d69974314cedb294",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"pixelmatch": "^8.0.0",
		"playwright": "1.64.1",
		"pngjs": "^7.0.0",
		"svelte": "^5.57.3",
		"svelte-check-native": "^1.11.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.6"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"packageManager": "bun@1.4.4"
}
